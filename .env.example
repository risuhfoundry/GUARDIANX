# GUARDIAN X — required environment variables
#
# Copy to .env.local and fill in real values from your Supabase project:
#   Dashboard -> Project Settings -> API
#
# .env.local is already gitignored. Never commit real values.
#
# These are browser-safe values. Vite inlines anything prefixed with VITE_
# into the client bundle, so only ever put a public key here.
#
# NEVER put the service_role key in this file or anywhere in src/ — it grants
# full database access and must stay server-side.

# Project URL, e.g. https://abcdefghijklm.supabase.co
VITE_SUPABASE_URL=

# anon key, or the newer sb_publishable_... key. NOT the service_role key.
VITE_SUPABASE_ANON_KEY=

# --- Test credentials (optional) ---------------------------------------------
#
# `pnpm test` verifies row-level security against the live project. The
# anonymous-access checks always run; these only add the signed-in checks for
# admin access, teacher scoping, sign-out and session restore.
#
# Put them in .env.local — never in this file, never in a commit. Without them
# those checks report SKIP, which is not the same as passing.
#
# GUARDIANX_TEST_ADMIN_EMAIL=
# GUARDIANX_TEST_ADMIN_PASSWORD=
# GUARDIANX_TEST_TEACHER_EMAIL=
# GUARDIANX_TEST_TEACHER_PASSWORD=
